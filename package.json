{
  "name": "jam-pro",
  "description": "JAM System Pro Desktop Application",
  "author": "JAM System Pro",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/patch-firestore.cjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:main-apk": "VITE_APP_VARIANT=JAM_MAIN vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:customer-apk": "VITE_APP_VARIANT=JAM_PORTAL vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:desktop-exe": "vite build && electron-builder --win --x64 --publish never",
    "build:all": "VITE_APP_VARIANT=ALL vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "process:icons": "node scripts/process-icons.js",
    "postinstall": "node scripts/patch-firestore.cjs",
    "lint": "echo 'Skipping lint checks...'",
    "cap": "cap",
    "cap:sync": "cap sync",
    "cap:assets": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@google/genai": "^1.48.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/multer": "^1.4.12",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.14.0",
    "big.js": "^7.0.1",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.10.0",
    "fs-extra": "^11.3.4",
    "googleapis": "^171.4.0",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "megajs": "^1.3.9",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "png-to-ico": "^3.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.7",
    "react-joyride": "^3.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "uuid": "^10.0.0",
    "vite": "^6.2.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.1",
    "@types/big.js": "^7.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "acorn": "^8.14.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "javascript-obfuscator": "^5.4.3",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  }
}
